# ============================================================
# IMD Cyclone Detector – Environment Configuration
# Copy this file to .env and fill in your credentials
# ============================================================

# -- App --
APP_ENV=development
DEMO_MODE=true
SECRET_KEY=change-me-to-a-random-string
DEBUG=true

# -- Database (PostgreSQL + PostGIS) --
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cyclone_detector
POSTGRES_USER=cyclone
POSTGRES_PASSWORD=cyclone_secret

# -- Redis (Celery broker + cache) --
REDIS_URL=redis://redis:6379/0

# -- MinIO (object storage for imagery & model artifacts) --
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cyclone-data
MINIO_USE_SSL=false

# -- MOSDAC (INSAT-3D/3DR/3DS) --
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_BASE_URL=https://www.mosdac.gov.in

# -- Copernicus CDS (ERA5, for training only) --
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# -- NASA Earthdata (GPM IMERG, GHRSST, GIBS) --
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# -- NOAA NOMADS (GFS) --
GFS_BASE_URL=https://nomads.ncep.noaa.gov/dods/gfs_0p25

# -- PO.DAAC (SST) --
PODAAC_TOKEN=

# -- EUMETSAT (ASCAT) --
EUMETSAT_KEY=
EUMETSAT_SECRET=

# -- Frontend --
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
VITE_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json

# -- Logging --
LOG_LEVEL=INFO
LOG_FORMAT=json
